  m_Script: {fileID: 11500000, guid: a1c3e7f2b5d8049a63e2f91d47b0c358, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _title: Projectile Scene Note
  _notes:
  - Full Projectile System Test
  - ... OK this scene contains quite a bit of things, but all you have to know is
    F for firing, C to switch from 2d to 3d, and right shift in 3d to dash, space
    to jump in 3d,build the game, connect to wifi or hotspot start host, create lobby
    join from other client, and press play, and test the system, small note client
    user dosent move for some reason im too lazy to debug, but mess around with the
    configs and settings , also if u plan on firing a bunch of projectiles increase
    the trail pool limits and buffer sizes, also if u notice ur self flying indefinately
    in 2d, switch to 3d to fall back down, bugs i know right
  _textFile: {fileID: 0}
  _theme: 0
  _fontSize: 14
  _useCustomTextColor: 0
  _customTextColor: {r: 0, g: 0, b: 0, a: 1}
  _width: 320
  _maxBodyHeight: 360
  _cornerPadding: 8
  _anchor: 0
  _margin: {x: 16, y: 16}
  _draggable: 1
  _sortingOrder: 500
  _startVisible: 1
  _buildInEditMode: 1
