// Brought to u by MidManStudio
//
// Audio left com.midmanstudio.utilities for com.midmanstudio.audio.
// 1. delete_files removes the old audio code, its .meta files and the old native libraries.
//    delete_files only removes files, not folders, so every file is listed. Git does not track empty
//    folders, so the leftover empty folders disappear from the repo on commit.
// 2. patch_files removes the audio entries from the generated sandbox project files (Unity rewrites
//    them on the next open) and notes the new package in the sample descriptions.
//
// Apply it together with the audio-package replacements archive. Run with --dry-run --diff first.

@CONFIG(
  version    -> "1.0.0"
  author     -> "Mid-D-Man"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(

  ~delete_file<object>(_path) {
    return { path = _path }
  }

  ~patch_replace_text<object>(_path, _anchor, _content) {
    return { path = _path, op = "replace_text", anchor = _anchor, content = _content }
  }

  ~patch_replace_block<object>(_path, _start_anchor, _end_anchor, _content) {
    return {
      path         = _path
      op           = "replace_block"
      start_anchor = _start_anchor
      end_anchor   = _end_anchor
      content      = _content
    }
  }

)

@DATA(
  project_name = "MidManStudio_Unity"
  description  = "Remove the audio code from com.midmanstudio.utilities after the move to com.midmanstudio.audio"
  author       = "Mid-D-Man"

  delete_files::

    // Runtime/Audio: manager, limiter, bridge, spawnable audio
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_AudioLimiter.cs")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_AudioLimiter.cs.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_AudioManager.cs")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_AudioManager.cs.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_NativeAudioBridge.cs")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_NativeAudioBridge.cs.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_SpawnableAudio.cs")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Audio/MID_SpawnableAudio.cs.meta")

    // Audio library ScriptableObject
    delete_file("packages/com.midmanstudio.utilities/Runtime/Libraries/Configs/MID_AudioLibrarySO.cs")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Libraries/Configs/MID_AudioLibrarySO.cs.meta")

    // Editor/Audio: inspectors
    delete_file("packages/com.midmanstudio.utilities/Editor/Audio.meta")
    delete_file("packages/com.midmanstudio.utilities/Editor/Audio/MID_NativeAudioBridgeEditor.cs")
    delete_file("packages/com.midmanstudio.utilities/Editor/Audio/MID_NativeAudioBridgeEditor.cs.meta")

    // Tests/Runtime/Audio: benchmark runner
    delete_file("packages/com.midmanstudio.utilities/Tests/Runtime/Audio.meta")
    delete_file("packages/com.midmanstudio.utilities/Tests/Runtime/Audio/MID_AudioBenchRunner.cs")
    delete_file("packages/com.midmanstudio.utilities/Tests/Runtime/Audio/MID_AudioBenchRunner.cs.meta")

    // Runtime/Plugins: native mid_audio libraries (rebuilt into the audio package by build-audio-libs.yml)
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/arm64-v8a.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/arm64-v8a/libmid_audio.so")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/arm64-v8a/libmid_audio.so.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/armeabi-v7a.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/armeabi-v7a/libmid_audio.so")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/armeabi-v7a/libmid_audio.so.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/x86_64.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/x86_64/libmid_audio.so")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Android/x86_64/libmid_audio.so.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Linux.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Linux/libmid_audio.so")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Linux/libmid_audio.so.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Windows.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Windows/mid_audio.dll")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/Windows/mid_audio.dll.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/iOS.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/iOS/libmid_audio.a")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/iOS/libmid_audio.a.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/iOS/libmid_audio_sim.a")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/iOS/libmid_audio_sim.a.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/macOS.meta")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/macOS/libmid_audio.dylib")
    delete_file("packages/com.midmanstudio.utilities/Runtime/Plugins/Native/Audio/macOS/libmid_audio.dylib.meta")

  patch_files::

    // Generated sandbox project files: drop the entries for the deleted files.
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.csproj",
      "utilities/Runtime/Audio/MID_AudioLimiter.cs",
      "</Compile>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.csproj",
      "utilities/Runtime/Audio/MID_NativeAudioBridge.cs",
      "</Compile>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.csproj",
      "utilities/Runtime/Audio/MID_SpawnableAudio.cs",
      "</Compile>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.csproj",
      "utilities/Runtime/Audio/MID_AudioManager.cs",
      "</Compile>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.csproj",
      "utilities/Runtime/Libraries/Configs/MID_AudioLibrarySO.cs",
      "</Compile>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.csproj",
      "utilities/Runtime/Plugins/Native/Audio/Windows/mid_audio.dll",
      "</None>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.Editor.csproj",
      "utilities/Editor/Audio/MID_NativeAudioBridgeEditor.cs",
      "</Compile>",
      "")
    patch_replace_block("PackageSandbox/MidManStudio.Utilities.Tests.csproj",
      "utilities/Tests/Runtime/Audio/MID_AudioBenchRunner.cs",
      "</Compile>",
      "")

    // Sample descriptions: the audio parts of these samples need the audio package.
    patch_replace_text("packages/com.midmanstudio.utilities/package.json",
      "Test native autio,tick system and timers",
      "Test native audio (needs com.midmanstudio.audio), tick system and timers")

    patch_replace_text("packages/com.midmanstudio.utilities/package.json",
      "native audio, as well as the local object pool for spawnable audio",
      "native audio and spawnable audio (both need com.midmanstudio.audio), as well as the local object pool")
)
