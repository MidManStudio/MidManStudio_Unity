/* ─── Palette (matches house theme) ─────────────────────────────────────── */
:root {
    --green:    rgba(71,  230, 115, 1.0);
    --blue:     rgba(100, 165, 255, 1.0);
    --orange:   rgba(255, 180,  64, 1.0);
    --red:      rgba(255,  90,  90, 1.0);
    --yellow:   rgba(255, 200,  60, 1.0);

    --text-hi:  rgba(210, 210, 210, 1.0);
    --text-mid: rgba(145, 145, 145, 1.0);
    --text-lo:  rgba( 80,  80,  80, 1.0);

    --bg-0:     rgba( 22,  22,  24, 1.0);
    --bg-1:     rgba( 32,  32,  34, 1.0);
    --bg-2:     rgba( 44,  44,  46, 1.0);
    --bg-3:     rgba( 56,  56,  58, 1.0);

    --border:   rgba( 70,  70,  72, 0.6);
    --r-s:      4px;
    --r-m:      6px;
}

.mid-root { flex-direction: column; flex-grow: 1; background-color: var(--bg-0); }

/* ─── Header ─────────────────────────────────────────────────────────────── */
.mid-header {
    min-height: 48px; flex-direction: row; align-items: center; justify-content: space-between;
    padding: 0 14px; background-color: var(--bg-1);
    border-bottom-width: 1px; border-bottom-color: var(--border);
}
.mid-header__text  { flex-direction: column; justify-content: center; }
.mid-header__title { font-size: 13px; -unity-font-style: bold; color: var(--text-hi); }
.mid-header__sub   { font-size: 10px; color: var(--text-mid); margin-top: 2px; }
.mid-header__refresh {
    width: 26px; height: 26px; border-radius: var(--r-s); border-width: 1px; border-color: var(--border);
    background-color: rgba(255,255,255,0.06); color: var(--text-mid); font-size: 14px;
    -unity-text-align: middle-center; padding: 0;
}
.mid-header__refresh:hover { background-color: rgba(255,255,255,0.13); color: var(--text-hi); }

/* ─── Options ────────────────────────────────────────────────────────────── */
.mid-options { padding: 8px 14px; background-color: var(--bg-1); border-bottom-width: 1px; border-bottom-color: var(--border); }
.mid-options .unity-toggle       { margin: 2px 0; }
.mid-options .unity-toggle__text { color: var(--text-hi); font-size: 11px; }
.mid-options__row { flex-direction: row; align-items: center; }
.mid-options__row .unity-object-field { flex-grow: 1; margin-left: 8px; }

/* ─── Toolbar ────────────────────────────────────────────────────────────── */
.mid-toolbar { flex-direction: row; flex-wrap: wrap; padding: 6px 10px; background-color: var(--bg-2); border-bottom-width: 1px; border-bottom-color: var(--border); }
.mid-toolbar Button {
    margin: 2px 4px 2px 0; padding: 4px 10px; border-radius: var(--r-s); border-width: 1px; border-color: var(--border);
    background-color: var(--bg-3); color: var(--text-hi); font-size: 11px;
}
.mid-toolbar Button:hover { background-color: rgba(255,255,255,0.10); }

/* ─── Body / Panels ──────────────────────────────────────────────────────── */
.mid-body  { flex-direction: row; flex-grow: 1; }
.mid-panel { flex-grow: 1; flex-basis: 0; flex-direction: column; border-right-width: 1px; border-right-color: var(--border); }
.mid-panel:last-child { border-right-width: 0; }
.mid-panel__title {
    font-size: 10px; -unity-font-style: bold; color: var(--text-mid); padding: 6px 10px;
    background-color: var(--bg-1); border-bottom-width: 1px; border-bottom-color: var(--border);
}
.mid-list { flex-grow: 1; background-color: var(--bg-0); }

/* ─── Target rows ────────────────────────────────────────────────────────── */
.mid-row        { flex-direction: row; align-items: center; padding: 2px 8px; }
.mid-row__dot   { width: 14px; font-size: 12px; -unity-text-align: middle-center; }
.mid-row__dot--on  { color: var(--green); }
.mid-row__dot--off { color: var(--text-lo); }
.mid-row__label { color: var(--text-hi); font-size: 11px; }

/* ─── Log entries ────────────────────────────────────────────────────────── */
.mid-log             { font-size: 10px; padding: 1px 10px; white-space: normal; }
.mid-log--ok         { color: var(--green); }
.mid-log--ambiguous  { color: var(--yellow); }
.mid-log--warn       { color: var(--red); }

/* ─── Footer ─────────────────────────────────────────────────────────────── */
.mid-footer { min-height: 26px; justify-content: center; padding: 0 14px; background-color: var(--bg-1); border-top-width: 1px; border-top-color: var(--border); }
.mid-footer__label { font-size: 10px; color: var(--text-mid); }
