:root {
    --text-hi:  rgba(210, 210, 210, 1.0);
    --text-mid: rgba(145, 145, 145, 1.0);
    --bg-0:     rgba( 22,  22,  24, 1.0);
    --bg-1:     rgba( 32,  32,  34, 1.0);
    --bg-2:     rgba( 44,  44,  46, 1.0);
    --bg-3:     rgba( 56,  56,  58, 1.0);
    --border:   rgba( 70,  70,  72, 0.6);
    --r-s:      4px;
}

.mid-root { flex-direction: column; flex-grow: 1; background-color: var(--bg-0); }

.mid-header {
    min-height: 44px; justify-content: center; padding: 0 14px;
    background-color: var(--bg-1); border-bottom-width: 1px; border-bottom-color: var(--border);
}
.mid-header__title { font-size: 13px; -unity-font-style: bold; color: var(--text-hi); }
.mid-header__sub   { font-size: 10px; color: var(--text-mid); margin-top: 2px; }

.mid-options { padding: 8px 14px; background-color: var(--bg-1); border-bottom-width: 1px; border-bottom-color: var(--border); }
.mid-options .unity-base-field__label { color: var(--text-hi); font-size: 11px; min-width: 140px; }
.mid-options__section-label { font-size: 10px; -unity-font-style: bold; color: var(--text-mid); margin-top: 10px; margin-bottom: 2px; }

.mid-toolbar { flex-direction: row; padding: 8px 10px; background-color: var(--bg-2); border-bottom-width: 1px; border-bottom-color: var(--border); }
.mid-toolbar Button {
    flex-grow: 1; margin: 0 4px; padding: 6px 10px; border-radius: var(--r-s);
    border-width: 1px; border-color: var(--border); background-color: var(--bg-3); color: var(--text-hi); font-size: 11px;
}
.mid-toolbar Button:hover { background-color: rgba(255,255,255,0.10); }

.mid-footer { min-height: 30px; justify-content: center; padding: 0 14px; background-color: var(--bg-1); }
.mid-footer__label { font-size: 10px; color: var(--text-mid); white-space: normal; }
