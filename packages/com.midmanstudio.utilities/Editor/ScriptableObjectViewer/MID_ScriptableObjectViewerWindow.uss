/* ─── Palette (matches house theme) ─────────────────────────────────────── */
:root {
    --green:    rgba(71,  230, 115, 1.0);
    --blue:     rgba(100, 165, 255, 1.0);
    --orange:   rgba(255, 180,  64, 1.0);
    --red:      rgba(255,  90,  90, 1.0);
    --yellow:   rgba(255, 200,  60, 1.0);

    --text-hi:  rgba(210, 210, 210, 1.0);
    --text-mid: rgba(145, 145, 145, 1.0);
    --text-lo:  rgba( 80,  80,  80, 1.0);

    --bg-0:     rgba( 22,  22,  24, 1.0);
    --bg-1:     rgba( 32,  32,  34, 1.0);
    --bg-2:     rgba( 44,  44,  46, 1.0);
    --bg-3:     rgba( 56,  56,  58, 1.0);

    --border:   rgba( 70,  70,  72, 0.6);
    --r-s:      4px;
    --r-m:      6px;
}

.mid-root { flex-direction: column; flex-grow: 1; background-color: var(--bg-0); }

/* ─── Header ─────────────────────────────────────────────────────────────── */
.mid-header {
    min-height: 48px; flex-direction: row; align-items: center; justify-content: space-between;
    padding: 0 14px; background-color: var(--bg-1);
    border-bottom-width: 1px; border-bottom-color: var(--border);
}
.mid-header__text  { flex-direction: column; justify-content: center; }
.mid-header__title { font-size: 13px; -unity-font-style: bold; color: var(--text-hi); }
.mid-header__sub   { font-size: 10px; color: var(--text-mid); margin-top: 2px; }
.mid-header__refresh {
    width: 26px; height: 26px; border-radius: var(--r-s); border-width: 1px; border-color: var(--border);
    background-color: rgba(255,255,255,0.06); color: var(--text-mid); font-size: 14px;
    -unity-text-align: middle-center; padding: 0;
}
.mid-header__refresh:hover { background-color: rgba(255,255,255,0.13); color: var(--text-hi); }

/* ─── Filters ────────────────────────────────────────────────────────────── */
.mid-filters { padding: 8px 14px; background-color: var(--bg-1); border-bottom-width: 1px; border-bottom-color: var(--border); }
.mid-filters .unity-base-field__label { color: var(--text-hi); font-size: 11px; min-width: 90px; }
.mid-filters__category { margin-bottom: 6px; }
.mid-filters__row { flex-direction: row; align-items: center; }
.mid-filters__search { flex-grow: 1; margin-right: 12px; }
.mid-filters__folder { flex-grow: 1; }

/* ─── Body / Panels ──────────────────────────────────────────────────────── */
.mid-body  { flex-direction: row; flex-grow: 1; }
.mid-panel { flex-direction: column; border-right-width: 1px; border-right-color: var(--border); }
.mid-panel:last-child { border-right-width: 0; }
.mid-panel--results { flex-grow: 1; flex-basis: 0; min-width: 220px; max-width: 340px; }
.mid-panel--detail  { flex-grow: 2; flex-basis: 0; }
.mid-panel__title {
    font-size: 10px; -unity-font-style: bold; color: var(--text-mid); padding: 6px 10px;
    background-color: var(--bg-1); border-bottom-width: 1px; border-bottom-color: var(--border);
}
.mid-list { flex-grow: 1; background-color: var(--bg-0); }

/* ─── Pagination ──────────────────────────────────────────────────────────── */
.mid-pagination {
    flex-direction: row; align-items: center; justify-content: center;
    min-height: 28px; padding: 4px 8px; background-color: var(--bg-1);
    border-top-width: 1px; border-top-color: var(--border);
}
.mid-pagination__btn {
    width: 24px; height: 20px; padding: 0; margin: 0 8px;
    border-radius: var(--r-s); border-width: 1px; border-color: var(--border);
    background-color: rgba(255,255,255,0.06); color: var(--text-mid); font-size: 10px;
    -unity-text-align: middle-center;
}
.mid-pagination__btn:hover:enabled { background-color: rgba(255,255,255,0.13); color: var(--text-hi); }
.mid-pagination__btn:disabled { opacity: 0.35; }
.mid-pagination__label { font-size: 10px; color: var(--text-mid); min-width: 90px; -unity-text-align: middle-center; }

/* ─── Result rows ────────────────────────────────────────────────────────── */
.mid-row          { flex-direction: row; align-items: center; padding: 3px 8px; }
.mid-row__icon    { width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; }
.mid-row__text-col{ flex-direction: column; overflow: hidden; }
.mid-row__name    { color: var(--text-hi); font-size: 11px; overflow: hidden; text-overflow: ellipsis; }
.mid-row__type    { color: var(--text-mid); font-size: 9px; margin-top: 1px; }

/* ─── Detail panel ───────────────────────────────────────────────────────── */
.mid-detail__empty {
    flex-grow: 1; align-items: center; justify-content: center; padding: 24px;
}
.mid-detail__empty Label { color: var(--text-lo); font-size: 11px; -unity-text-align: middle-center; white-space: normal; }
.mid-detail__scroll { flex-grow: 1; padding: 10px 14px; }

/* ─── Footer ─────────────────────────────────────────────────────────────── */
.mid-footer { min-height: 26px; justify-content: center; padding: 0 14px; background-color: var(--bg-1); border-top-width: 1px; border-top-color: var(--border); }
.mid-footer__label { font-size: 10px; color: var(--text-mid); }
